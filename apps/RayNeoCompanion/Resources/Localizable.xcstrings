          }
        }
      }
    },
    "Keeps the original request without automatically creating a second task. If the token is wrong, save a corrected token for the current address, then verify. The address cannot change until verification finishes. Pending verification data is stored temporarily on this device and cleared after confirmation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the original request without automatically creating a second task. If the token is wrong, save a corrected token for the current address, then verify. The address cannot change until verification finishes. Pending verification data is stored temporarily on this device and cleared after confirmation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留原请求，不自动创建第二个任务。令牌错误时可重新保存当前地址的令牌，再点核对；核对完成前不能更换地址。待核对内容临时保存在本机，确认后清除。"
          }
        }
      }
    },
    "Keys are available only on this device after unlock and are not written to logs or configuration files. Recognition and speech options are draft preferences only; they do not run models or change glasses settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys are available only on this device after unlock and are not written to logs or configuration files. Recognition and speech options are draft preferences only; they do not run models or change glasses settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥仅当前设备、解锁后可用，不写入日志或配置文件。识别与语音选项只是策略草稿，不会运行模型或更改眼镜设置。"
          }
        }
      }
    },
    "Keys are saved separately for each full service address and are not reused across addresses.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys are saved separately for each full service address and are not reused across addresses."
