    "This local audio is sent to Alibaba Cloud ASR only after you confirm. Streaming follows the audio duration and may incur charges. DeepSeek is not required, and no summary is generated automatically. Success adds a text revision without overwriting the original audio or earlier drafts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This local audio is sent to Alibaba Cloud ASR only after you confirm. Streaming follows the audio duration and may incur charges. DeepSeek is not required, and no summary is generated automatically. Success adds a text revision without overwriting the original audio or earlier drafts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有确认后才把这份本机音频发送给阿里云 ASR。按音频时长流式发送，可能计费；无需 DeepSeek，不自动总结。成功后新增文字修订，不覆盖原音频或旧稿。"
          }
        }
      }
    },
    "Keep the app in the foreground during transcription. Long-running background completion has not been verified.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the app in the foreground during transcription. Long-running background completion has not been verified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写期间请保持 App 在前台；长时间后台完成尚未验收。"
          }
        }
      }
    },
    "By default, all channels are mixed and converted to 16 kHz mono. The original recording is retained and is not overwritten.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default, all channels are mixed and converted to 16 kHz mono. The original recording is retained and is not overwritten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认合并全部声道，再转为16kHz单声道；保留原始录音，不覆盖音频。"
          }
        }
      }
    },
    "Save ASR Diagnostics for the Next Run Only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save ASR Diagnostics for the Next Run Only"
