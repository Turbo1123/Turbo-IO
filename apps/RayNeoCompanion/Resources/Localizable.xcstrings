    "This is a one-time copy, not continuous sync. Titles are limited to 300 characters. Recurrence rules, subtask relationships, notes, and system alerts are not copied. System originals stay unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a one-time copy, not continuous sync. Titles are limited to 300 characters. Recurrence rules, subtask relationships, notes, and system alerts are not copied. System originals stay unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一次性复制，不持续同步。标题最多保留 300 字；不复制重复规则、子任务关系、备注或系统提醒。系统原件保持不变。"
          }
        }
      }
