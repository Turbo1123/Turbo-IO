          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 17 起系统权限名为“完全访问”，但Turbo IO仅执行读取，不修改系统待办。导入不会自动发送到眼镜，也不创建通知。"
          }
