          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "协议范围：业务 21；下发 type 33，匹配 type 34 回传后删除并发送 type 35 回执。未验证的回传会被忽略。"
          }
        }
      }
