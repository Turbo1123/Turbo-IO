          }
        }
      }
    },
    "Checks only a subset of Ogg / Opus declarations. Does not play, decode, or run speech recognition.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks only a subset of Ogg / Opus declarations. Does not play, decode, or run speech recognition."
