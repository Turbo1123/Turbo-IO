      }
    },
    "Also saves this run's sent audio and server responses, which may contain the transcript, locally. Request headers and keys are not recorded.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also saves this run's sent audio and server responses, which may contain the transcript, locally. Request headers and keys are not recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将额外保存本次发送音频和服务端响应（可能含转录正文），仅存本机；不记录请求头或密钥。"
          }
        }
      }
