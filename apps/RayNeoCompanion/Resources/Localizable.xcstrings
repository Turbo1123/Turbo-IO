    "Repeated imports of the same source ID are skipped, including locally removed to-dos. Local edits are not overwritten, and removed items are not restored automatically. If system sync recreates source IDs, they may still be treated as new items.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeated imports of the same source ID are skipped, including locally removed to-dos. Local edits are not overwritten, and removed items are not restored automatically. If system sync recreates source IDs, they may still be treated as new items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一来源标识重复导入会跳过，包括已移除的本机待办，不覆盖编辑也不自动恢复。系统同步若重建来源标识，仍可能视为新条目。"
          }
        }
      }
    },
