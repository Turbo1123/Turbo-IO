    "I Confirmed the Glasses Feature Is Off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I Confirmed the Glasses Feature Is Off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已确认眼镜关闭"
          }
        }
      }
    },
    "Use only after visually confirming All-Day Notes is off on the glasses. A successful switch acknowledgment is not proof of OFF status. Manual confirmation is recorded separately.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use only after visually confirming All-Day Notes is off on the glasses. A successful switch acknowledgment is not proof of OFF status. Manual confirmation is recorded separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在目视确认眼镜全天智记已关闭后使用；开关成功回执不等于 OFF 状态，人工确认单独记录。"
          }
        }
      }
    },
    "Inform people nearby and use test phrases before starting. AI voice standby will pause and cloud audio capture will not resume automatically afterward. Disconnection or force quit cannot guarantee an immediate remote stop. Keep the glasses connected to your phone and observe them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inform people nearby and use test phrases before starting. AI voice standby will pause and cloud audio capture will not resume automatically afterward. Disconnection or force quit cannot guarantee an immediate remote stop. Keep the glasses connected to your phone and observe them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始前请告知周围人并使用测试语句。会暂停 AI 语音待命；结束后不会自动恢复云收音。断连或强退不能保证远端立即停止，请保持眼镜与手机连接并观察。"
          }
        }
      }
    },
    "Protocol Events (No Audio Content)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protocol Events (No Audio Content)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "协议事件（无音频正文）"
          }
        }
      }
    },
    "Have you checked the glasses and confirmed All-Day Notes is off? This records manual confirmation, not a protocol verification pass.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have you checked the glasses and confirmed All-Day Notes is off? This records manual confirmation, not a protocol verification pass."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认已查看眼镜，全天智记已关闭？这会记录人工确认，不标记为协议验证通过。"
          }
        }
      }
    },
    "Confirm Glasses Feature Is Off": {
