            "value": "本机结构检查"
          }
        }
      }
    },
    "A valid container does not prove usable sound.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A valid container does not prove usable sound."
