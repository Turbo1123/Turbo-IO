  "query_shape": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "rayneo"
        },
        "segment_id": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "description": "inclusive ISO-8601 window start"
        },
        "to": {
          "type": "string",
          "description": "inclusive ISO-8601 window end"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        },
        "max_text_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8000,
          "default": 2000
        },
        "max_total_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8000,
          "default": 4000
        },
        "include_derived": {
          "type": "boolean",
          "default": true
        },
        "as_of": {
          "type": "string",
          "description": "task-local clock for TTL/freshness; live collectors omit this"
        }
      }
    },
    "response_item": {
      "source": "rayneo",
      "source_ref": "string",
      "revision": "integer",
      "segment_id": "string",
      "text_kind": "transcript | summary",
      "text": "string omitted when full-text TTL expired or tombstoned",
      "time_semantics": {
        "source_time": "string | null",
        "source_time_unknown": "boolean",
        "received_at": "string",
        "query_clock": "source_time when known; otherwise received_at labeled unknown — never treat receive time as source time"
      },
      "freshness": "recent | historical | unknown_source_time | expired",
      "coverage": "object",
      "gaps": "array",
      "expired": "boolean",
      "instruction_eligible": false
    },
    "limits": {
      "max_window_ms": 604800000,
      "max_count": 50,
      "max_text_chars": 8000,
      "max_total_tokens": 8000,
      "token_estimate": "ceil(UTF-16 code units / 4)"
    }
  },
  "retention": {
    "full_text_ttl_ms": 604800000,
    "ttl_is_not_delete": true,
    "user_delete_tombstones": true,
    "derived_may_outlive_full_text_ttl": true,
    "derived_must_not_survive_user_delete_as_equivalent_full_text": true
  },
  "derivation": {
    "auto_persist_on_ingest": true,
    "manual_save_required": false,
    "extractor": "rayneo-fixture-extractor/v1",
    "live_model": "pending",
    "label": "derived-from-transcript",
