 TIOEditorialNavigation *nav=(id)vc.navigationController;
 // Homepage-only routes retain the original panel dispatcher, including AI configuration.
 NSMutableArray *routes=[pages mutableCopy];
 if([key isEqual:@"dashboardEditor"]||[key isEqual:@"developerApps"]){
