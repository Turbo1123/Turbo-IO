 CGGradientRef sweep=CGGradientCreateWithColors(cs,(__bridge CFArrayRef)@[(id)UIColor.clearColor.CGColor,(id)[Color(227,197,163)colorWithAlphaComponent:.035].CGColor,(id)UIColor.clearColor.CGColor],NULL);
