 for(int i=0;i<3;i++){UIColor *color=colors[i];CGGradientRef g=CGGradientCreateWithColors(cs,(__bridge CFArrayRef)@[(id)[color colorWithAlphaComponent:.68].CGColor,(id)[color colorWithAlphaComponent:0].CGColor],NULL);CGContextDrawRadialGradient(c,g,points[i],0,points[i],radii[i],0);CGGradientRelease(g);}
