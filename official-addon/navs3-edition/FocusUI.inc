- (BOOL)eyeMode{return self.target.selectedSegmentIndex==1;}
- (double)remaining{if(self.eyeMode)return TFFocusBridge.shared.remaining;double end=[self.prefs doubleForKey:@"end"];return end>0?MAX(0,end-NSDate.date.timeIntervalSince1970):[self.prefs doubleForKey:@"remaining"];}
- (void)viewDidLoad{[super viewDidLoad];self.title=@"番茄时钟";self.prefs=[[NSUserDefaults alloc]initWithSuiteName:@"org.turboio.addon.focus"];[self.prefs registerDefaults:@{@"minutes":@25,@"remaining":@1500}];Pin(EditorialBackdrop(),self.view,0);
 UIImageView *art=[[UIImageView alloc]initWithImage:TIOArtwork(@"focus-tomato-v2")];art.contentMode=UIViewContentModeScaleAspectFit;art.clipsToBounds=YES;art.backgroundColor=UIColor.clearColor;art.accessibilityIdentifier=@"focus-blended-art";[art.heightAnchor constraintEqualToConstant:240].active=YES;
 self.clockLabel=Label(@"25:00",72,UIFontWeightSemibold);self.clockLabel.font=[UIFont monospacedDigitSystemFontOfSize:72 weight:UIFontWeightSemibold];self.clockLabel.textAlignment=NSTextAlignmentCenter;self.status=Label(@"给这一件事，一点完整的时间。",14,UIFontWeightRegular);self.status.textColor=UIColor.secondaryLabelColor;self.status.textAlignment=NSTextAlignmentCenter;
 self.duration=[[UISegmentedControl alloc]initWithItems:@[@"15 分钟",@"25 分钟",@"45 分钟"]];NSUInteger index=[@[@15,@25,@45]indexOfObject:@([self.prefs integerForKey:@"minutes"])];self.duration.selectedSegmentIndex=index==NSNotFound?1:index;[self.duration addTarget:self action:@selector(changeDuration) forControlEvents:UIControlEventValueChanged];
 self.toggle=[UIButton buttonWithType:UIButtonTypeSystem];UIButtonConfiguration *cfg=[UIButtonConfiguration filledButtonConfiguration];cfg.baseBackgroundColor=TIOAccent();cfg.baseForegroundColor=TIOPaper();cfg.cornerStyle=UIButtonConfigurationCornerStyleCapsule;self.toggle.configuration=cfg;[self.toggle.heightAnchor constraintGreaterThanOrEqualToConstant:52].active=YES;[self.toggle addTarget:self action:@selector(toggleTimer) forControlEvents:UIControlEventTouchUpInside];self.toggle.accessibilityIdentifier=@"focus-toggle";
 UIButton *reset=[UIButton buttonWithType:UIButtonTypeSystem];[reset setTitle:@"结束并重置" forState:UIControlStateNormal];[reset addTarget:self action:@selector(confirmReset) forControlEvents:UIControlEventTouchUpInside];[reset.heightAnchor constraintGreaterThanOrEqualToConstant:44].active=YES;reset.accessibilityIdentifier=@"focus-reset";
 self.target=[[UISegmentedControl alloc]initWithItems:@[@"手机本机",@"眼镜独立计时"]];self.target.selectedSegmentIndex=[self.prefs boolForKey:@"eyeMode"]?1:0;[self.target addTarget:self action:@selector(changeTarget) forControlEvents:UIControlEventValueChanged];
 self.peekButton=[UIButton buttonWithType:UIButtonTypeSystem];[self.peekButton setTitle:@"刷新 / 查看眼镜计时" forState:UIControlStateNormal];[self.peekButton addTarget:self action:@selector(peek) forControlEvents:UIControlEventTouchUpInside];[self.peekButton.heightAnchor constraintGreaterThanOrEqualToConstant:44].active=YES;
 UIButton *more=[UIButton buttonWithType:UIButtonTypeSystem];[more setTitle:@"更多设置 · 休息与测试" forState:UIControlStateNormal];[more addTarget:self action:@selector(more) forControlEvents:UIControlEventTouchUpInside];[more.heightAnchor constraintGreaterThanOrEqualToConstant:44].active=YES;
 UILabel *note=Label(@"手机本机计时 · 后台不会重置",12,UIFontWeightRegular);self.eyeNote=note;note.textColor=UIColor.secondaryLabelColor;note.textAlignment=NSTextAlignmentCenter;
 UIStackView *stack=[[UIStackView alloc]initWithArrangedSubviews:@[art,self.status,self.clockLabel,self.duration,self.target,self.toggle,self.peekButton,reset,more,note]];stack.axis=UILayoutConstraintAxisVertical;stack.spacing=14;UIScrollView *scroll=[UIScrollView new];scroll.translatesAutoresizingMaskIntoConstraints=NO;scroll.contentInsetAdjustmentBehavior=UIScrollViewContentInsetAdjustmentNever;scroll.contentInset=UIEdgeInsetsMake(0,0,88,0);scroll.accessibilityIdentifier=@"focus-safe-scroll";[self.view addSubview:scroll];[NSLayoutConstraint activateConstraints:@[[scroll.leadingAnchor constraintEqualToAnchor:self.view.safeAreaLayoutGuide.leadingAnchor],[scroll.trailingAnchor constraintEqualToAnchor:self.view.safeAreaLayoutGuide.trailingAnchor],[scroll.topAnchor constraintEqualToAnchor:self.view.safeAreaLayoutGuide.topAnchor],[scroll.bottomAnchor constraintEqualToAnchor:self.view.safeAreaLayoutGuide.bottomAnchor]]];stack.translatesAutoresizingMaskIntoConstraints=NO;[scroll addSubview:stack];[NSLayoutConstraint activateConstraints:@[[stack.leadingAnchor constraintEqualToAnchor:scroll.contentLayoutGuide.leadingAnchor constant:24],[stack.trailingAnchor constraintEqualToAnchor:scroll.contentLayoutGuide.trailingAnchor constant:-24],[stack.topAnchor constraintEqualToAnchor:scroll.contentLayoutGuide.topAnchor constant:24],[stack.bottomAnchor constraintEqualToAnchor:scroll.contentLayoutGuide.bottomAnchor constant:-24],[stack.widthAnchor constraintEqualToAnchor:scroll.frameLayoutGuide.widthAnchor constant:-48]]];[self refresh];}
- (void)refresh{if(self.eyeMode){TFFocusBridge *b=TFFocusBridge.shared;[b pump];NSDictionary *q=b.snapshot;unsigned state=[q[@"status"]unsignedIntValue],phase=[q[@"phase"]unsignedIntValue];NSInteger seconds=(NSInteger)ceil(b.remaining);if(state==TF_IDLE||state==TF_STOPPED)seconds=[self.prefs integerForKey:@"minutes"]*60;self.clockLabel.text=q?[NSString stringWithFormat:@"%02ld:%02ld",(long)seconds/60,(long)seconds%60]:@"--:--";self.status.text=!q?@"先刷新眼镜状态":state==TF_RUNNING?(phase?@"休息中":@"专注中"):state==TF_PAUSED?@"已暂停":state==TF_DONE?@"这一轮完成了":@"准备开始";UIButtonConfiguration *cfg=self.toggle.configuration;cfg.title=!b.ready?@"连接并刷新状态":state==TF_RUNNING?@"暂停":state==TF_PAUSED?@"继续":@"开始专注";self.toggle.configuration=cfg;self.toggle.enabled=!b.busy;self.duration.enabled=state!=TF_RUNNING&&state!=TF_PAUSED&&!b.busy;self.peekButton.hidden=NO;self.peekButton.enabled=!b.busy;self.eyeNote.text=[b.note stringByAppendingString:@"\n前3秒完整显示，随后小提示；10秒后释放亮屏保持，随后按系统息屏。短按暂停/继续，长按停止并退出（TFP1-04）；手机断连也可操作。抬头需开启原厂头控；到时空闲才提醒。重启眼镜会中断本轮计时。"];return;}self.toggle.enabled=YES;self.peekButton.hidden=YES;self.eyeNote.text=@"本机计时 · 返回或切后台不会重置\n不向眼镜发送，不提供手机后台提醒。";double left=[self remaining];if([self.prefs doubleForKey:@"end"]>0&&left<=0){[self.prefs setDouble:0 forKey:@"end"];[self.prefs setDouble:0 forKey:@"remaining"];}NSInteger seconds=(NSInteger)ceil(left);self.clockLabel.text=[NSString stringWithFormat:@"%02ld:%02ld",(long)seconds/60,(long)seconds%60];BOOL running=[self.prefs doubleForKey:@"end"]>0;UIButtonConfiguration *cfg=self.toggle.configuration;cfg.title=running?@"暂停专注":left<=0?@"再来一轮":@"开始 / 继续";self.toggle.configuration=cfg;self.duration.enabled=!running;self.status.text=left<=0?@"这一轮完成了，休息一下。":running?@"专注进行中":@"这次，专注一件事。";}
- (void)toggleTimer{if(self.eyeMode){TFFocusBridge *b=TFFocusBridge.shared;if(!b.ready){[b query];[self refresh];return;}unsigned state=[b.snapshot[@"status"]unsignedIntValue];[b perform:state==TF_RUNNING?TF_PAUSE:state==TF_PAUSED?TF_RESUME:TF_START seconds:(state==TF_RUNNING||state==TF_PAUSED)?0:(unsigned)[self.prefs integerForKey:@"minutes"]*60 phase:0];[self refresh];return;}double left=[self remaining];if([self.prefs doubleForKey:@"end"]>0){[self.prefs setDouble:left forKey:@"remaining"];[self.prefs setDouble:0 forKey:@"end"];}else{if(left<=0)left=[self.prefs integerForKey:@"minutes"]*60;[self.prefs setDouble:NSDate.date.timeIntervalSince1970+left forKey:@"end"];}[self refresh];}
- (void)changeDuration{if(self.eyeMode){[self.prefs setInteger:[@[@15,@25,@45][self.duration.selectedSegmentIndex]integerValue] forKey:@"minutes"];[self refresh];return;}[self.prefs setInteger:[@[@15,@25,@45][self.duration.selectedSegmentIndex]integerValue] forKey:@"minutes"];[self reset];}
- (void)confirmReset{UIAlertController *a=[UIAlertController alertControllerWithTitle:@"结束本轮专注？" message:@"计时将回到所选时长。" preferredStyle:UIAlertControllerStyleAlert];__weak typeof(self) w=self;[a addAction:[UIAlertAction actionWithTitle:@"继续专注" style:UIAlertActionStyleCancel handler:nil]];[a addAction:[UIAlertAction actionWithTitle:@"重置" style:UIAlertActionStyleDestructive handler:^(UIAlertAction *x){[w reset];}]];[self presentViewController:a animated:YES completion:nil];}
- (void)reset{if(self.eyeMode){[TFFocusBridge.shared perform:TF_STOP seconds:0 phase:0];[self refresh];return;}[self.prefs setDouble:0 forKey:@"end"];[self.prefs setDouble:[self.prefs integerForKey:@"minutes"]*60 forKey:@"remaining"];[self refresh];}
- (void)changeTarget{[self.prefs setBool:self.eyeMode forKey:@"eyeMode"];if(self.eyeMode)[TFFocusBridge.shared query];[self refresh];}
- (void)peek{TFFocusBridge *b=TFFocusBridge.shared;if(b.ready&&[b.snapshot[@"sid"]unsignedIntValue])[b perform:TF_PEEK seconds:0 phase:0];else[b query];[self refresh];}
- (void)more{UIAlertController *a=[UIAlertController alertControllerWithTitle:@"番茄设置" message:@"高级功能在这里，主页面保持简洁。休息和短时验收只用于眼镜模式；已有计时不会被覆盖。" preferredStyle:UIAlertControllerStyleActionSheet];__weak typeof(self) w=self;
 [a addAction:[UIAlertAction actionWithTitle:@"自定义专注时长" style:UIAlertActionStyleDefault handler:^(UIAlertAction *x){[w customDuration];}]];
 if(self.eyeMode){for(NSDictionary *p in @[@{@"name":@"开始5分钟短休息",@"sec":@300,@"phase":@1},@{@"name":@"开始15分钟长休息",@"sec":@900,@"phase":@2},@{@"name":@"30秒短时验收（会提醒）",@"sec":@30,@"phase":@0}]){[a addAction:[UIAlertAction actionWithTitle:p[@"name"] style:UIAlertActionStyleDefault handler:^(UIAlertAction *x){[TFFocusBridge.shared perform:TF_START seconds:[p[@"sec"]unsignedIntValue] phase:[p[@"phase"]unsignedIntValue]];[w refresh];}]];}}
 [a addAction:[UIAlertAction actionWithTitle:@"取消" style:UIAlertActionStyleCancel handler:nil]];a.popoverPresentationController.sourceView=self.view;a.popoverPresentationController.sourceRect=CGRectMake(CGRectGetMidX(self.view.bounds),CGRectGetMidY(self.view.bounds),1,1);[self presentViewController:a animated:YES completion:nil];}
- (void)customDuration{UIAlertController *a=[UIAlertController alertControllerWithTitle:@"专注时长" message:@"5–120分钟；运行中的计时不变。" preferredStyle:UIAlertControllerStyleAlert];[a addTextFieldWithConfigurationHandler:^(UITextField *f){f.keyboardType=UIKeyboardTypeNumberPad;f.placeholder=@"25";}];__weak typeof(self) w=self;[a addAction:[UIAlertAction actionWithTitle:@"取消" style:UIAlertActionStyleCancel handler:nil]];[a addAction:[UIAlertAction actionWithTitle:@"保存" style:UIAlertActionStyleDefault handler:^(UIAlertAction *x){NSInteger n=[a.textFields.firstObject.text integerValue];if(n<5||n>120)return;[w.prefs setInteger:n forKey:@"minutes"];w.duration.selectedSegmentIndex=UISegmentedControlNoSegment;if(!w.eyeMode&&[w.prefs doubleForKey:@"end"]<=0)[w reset];[w refresh];}]];[self presentViewController:a animated:YES completion:nil];}
- (void)viewWillAppear:(BOOL)a{[super viewWillAppear:a];if(self.eyeMode)[TFFocusBridge.shared query];[self refresh];[self.ticker invalidate];__weak typeof(self) w=self;self.ticker=[NSTimer scheduledTimerWithTimeInterval:1 repeats:YES block:^(NSTimer *t){[w refresh];}];}
