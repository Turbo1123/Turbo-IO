// User-server recipes. All bundled packages are explicit offline examples.
static NSArray *GalleryItems(void){static NSArray *items;static dispatch_once_t once;dispatch_once(&once,^{NSString *p=[NSBundle.mainBundle pathForResource:@"catalog" ofType:@"json" inDirectory:@"TurboIOGallery"];NSDictionary *d=p?[NSJSONSerialization JSONObjectWithData:[NSData dataWithContentsOfFile:p] options:0 error:nil]:nil;items=[d[@"entries"] isKindOfClass:NSArray.class]?d[@"entries"]:@[];});return items;}
static NSData *GalleryBytes(NSDictionary *item){NSString *p=[NSBundle.mainBundle pathForResource:item[@"resource"] ofType:@"zip" inDirectory:@"TurboIOGallery"];if(!p)return nil;NSFileHandle *f=[NSFileHandle fileHandleForReadingAtPath:p];NSData *data=[f readDataUpToLength:24577 error:nil];[f closeAndReturnError:nil];return data;}
static NSDictionary *GalleryPackage(NSDictionary *item,NSString **error){NSDictionary *p=TAPReadPackage(GalleryBytes(item),error);if(p&&![p[@"zipSHA256"]isEqual:item[@"sha256"]]){if(error)*error=@"目录校验值不匹配，未加载应用。";return nil;}return p;}
static NSString *DeveloperPrompt(void){return @"请使用 Turbo IO 的 turboio-developer Skill，阅读 https://github.com/Turbo1123/Turbo-IO/blob/main/docs/DEVELOPER_ECOSYSTEM.md 。在我的 Server 连接我授权的 MCP，只读获取我选择的数据，密钥留在 Server。仪表盘使用 TCE1 API 的草稿/发布/手机批准；小应用使用 TAP1 540×180 原生组件、20KiB 解压预算、最多4页，生成 ZIP 并校验/预览。先离线演示，再接真实数据；不要假装联网、自动安装、刷机或执行付款等写操作。交付源码、ZIP、SHA256、测试、部署配置和手机导入步骤。App v1 是数据快照包，自动刷新和按钮后端回流尚未接入。";}
static void CopyPrompt(UIViewController *vc,NSString *text){UIPasteboard.generalPasteboard.string=text;Notice(vc,@"已复制。粘贴给你的 Agent，按提示连接自己的 Server。密钥无需填进提示词。");}
@interface TAPRecipe:UITableViewController
@property NSDictionary *item,*package;
@end
@implementation TAPRecipe
- (void)viewDidLayoutSubviews{[super viewDidLayoutSubviews];UIView *h=self.tableView.tableHeaderView;CGFloat w=self.tableView.bounds.size.width;CGFloat ph=(w-40)/3;h.frame=CGRectMake(0,0,w,ph+70);NSArray<UIView *> *v=h.subviews;if(v.count>=2){v[0].frame=CGRectMake(20,16,w-40,ph);v[1].frame=CGRectMake(20,ph+23,w-40,40);}}
- (void)viewDidLoad{[super viewDidLoad];self.title=_item[@"name"];TIOStyleResearchTable(self);NSString *error;self.package=GalleryPackage(_item,&error);UIView *header=[[UIView alloc]initWithFrame:CGRectMake(0,0,360,174)];TAPPreview *p=[[TAPPreview alloc]initWithFrame:CGRectMake(20,16,320,107)];p.autoresizingMask=UIViewAutoresizingFlexibleWidth;p.document=_package[@"document"];p.layer.cornerRadius=12;p.clipsToBounds=YES;[header addSubview:p];UILabel *note=[[UILabel alloc]initWithFrame:CGRectMake(20,130,320,36)];note.autoresizingMask=UIViewAutoresizingFlexibleWidth;note.numberOfLines=2;note.font=[UIFont systemFontOfSize:12];note.textColor=UIColor.secondaryLabelColor;note.text=_package?@"可安装的离线示例 · 真实数据由你自己的 Server 提供":(error?:@"示例包未附带");[header addSubview:note];self.tableView.tableHeaderView=header;}
- (NSInteger)numberOfSectionsInTableView:(UITableView *)t{return 2;}
- (NSInteger)tableView:(UITableView *)t numberOfRowsInSection:(NSInteger)s{return s?3:3;}
- (NSString *)tableView:(UITableView *)t titleForHeaderInSection:(NSInteger)s{return s?@"接入你的 Server":@"从这个模板开始";}
- (NSString *)tableView:(UITableView *)t titleForFooterInSection:(NSInteger)s{return s?@"这里只引用上游项目，不附带其服务或账号。ZIP 不含 MCP、JS 执行器或密钥；快照不是自动实时更新。":nil;}
- (UITableViewCell *)tableView:(UITableView *)t cellForRowAtIndexPath:(NSIndexPath *)p{UITableViewCell *c=[[UITableViewCell alloc]initWithStyle:UITableViewCellStyleSubtitle reuseIdentifier:nil];TIOStyleResearchCell(c);c.textLabel.numberOfLines=0;c.detailTextLabel.numberOfLines=0;if(!p.section){NSArray *names=@[@"预览并安装示例",@"复制 Agent 开发提示词",@"导出示例 ZIP"],*icons=@[@"play.rectangle",@"doc.on.doc",@"square.and.arrow.up"];c.textLabel.text=names[p.row];c.imageView.image=[UIImage systemImageNamed:icons[p.row]];c.accessibilityIdentifier=[NSString stringWithFormat:@"recipe-action-%ld",(long)p.row];c.accessoryType=UITableViewCellAccessoryDisclosureIndicator;c.detailTextLabel.text=p.row==0?@"检查内容与权限后再确认，不自动安装":p.row==1?@"包含来源、数据映射、限制和验收要求":@"可交给 Agent 修改，也可保存到文件";}else{c.textLabel.text=@[@"只读能力",@"配置要求",@"参考项目"][(NSUInteger)p.row];c.detailTextLabel.text=@[_item[@"purpose"],_item[@"setup"],_item[@"source"]][(NSUInteger)p.row];}return c;}
- (void)tableView:(UITableView *)t didSelectRowAtIndexPath:(NSIndexPath *)p{[t deselectRowAtIndexPath:p animated:YES];if(p.section)return;if(p.row==1){CopyPrompt(self,_item[@"prompt"]);return;}if(!_package){Notice(self,@"包未通过校验，无法继续。");return;}if(p.row==0){TAPReview *v=[TAPReview new];v.package=_package;[self.navigationController pushViewController:v animated:YES];return;}
 NSURL *dir=[NSURL fileURLWithPath:[NSTemporaryDirectory()stringByAppendingPathComponent:@"TurboGalleryExports"] isDirectory:YES];[NSFileManager.defaultManager createDirectoryAtURL:dir withIntermediateDirectories:YES attributes:nil error:nil];NSURL *file=[dir URLByAppendingPathComponent:[_item[@"id"]stringByAppendingString:@".zip"]];if(![GalleryBytes(_item)writeToURL:file options:NSDataWritingAtomic error:nil]){Notice(self,@"导出失败，未修改眼镜。");return;}UIActivityViewController *share=[[UIActivityViewController alloc]initWithActivityItems:@[file] applicationActivities:nil];share.popoverPresentationController.sourceView=self.view;share.popoverPresentationController.sourceRect=[t rectForRowAtIndexPath:p];[self presentViewController:share animated:YES completion:nil];}
@end
